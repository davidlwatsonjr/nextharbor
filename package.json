{
  "name": "nextharbor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build && vite preview --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build && node scripts/build-offline.mjs",
